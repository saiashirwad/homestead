{
  "name": "homestead",
  "version": "0.3.0",
  "description": "Isolated dev environments for git worktrees — dynamic ports, derived .env, and an Effect RPC control plane.",
  "bin": {
    "homestead": "src/cli.ts"
  },
  "files": [
    "index.ts",
    "src",
    "homestead.config.example.ts",
    "README.md"
  ],
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && effect-tsgo patch --typescript --oxlint",
    "homestead": "bun ./src/cli.ts",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
