{
  "name": "homestead",
  "version": "0.3.0",
  "description": "Isolated dev environments for git worktrees — dynamic ports, derived .env, and an Effect RPC control plane.",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "homestead": "src/cli.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "homestead.config.example.ts",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "homestead": "bun ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109"
  }
}
